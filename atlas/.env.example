# PostgreSQL 16 + PostGIS 3. Если не задано, приложение работает на встроенном
# seed-наборе (режим разработки без БД, помечается в интерфейсе).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/atlas

# Базовая карта (MapLibre style JSON). По умолчанию — CARTO Dark Matter
# (бесплатно с атрибуцией © OpenStreetMap contributors © CARTO).
NEXT_PUBLIC_MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json

# Публичный адрес сайта для canonical/sitemap
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Ticketmaster Discovery API (https://developer.ticketmaster.com/) —
# ключ Consumer Key. Без ключа адаптер помечается как «не подключён».
TICKETMASTER_API_KEY=
